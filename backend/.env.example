PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=
DB_USE_DATABASE_URL=false
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSL=false
# Hosted PostgreSQL should use DB_SSL=true and certificate verification.
# Production refuses DB_SSL_REJECT_UNAUTHORIZED=false.
DB_SSL_REJECT_UNAUTHORIZED=true
# Schema synchronization is development-only and opt-in. Production always skips it.
DB_SYNC=false
DB_SYNC_ALTER=false

# Authentication rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Authentication
JWT_SECRET=

# Payment credentials (leave empty until payment integration is approved)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
