PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL
# Copy this from Neon Dashboard -> Project -> Connection string.
# Use pooled connection for serverless/shared hosting, and keep sslmode=verify-full.
DATABASE_URL=postgresql://neondb_owner:npg_f2FshBHDc4Mi@ep-misty-fire-aympg475-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional database tuning
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_CONNECT_TIMEOUT_MS=30000
# Leave false for existing Neon databases. Set true only when you intentionally want Sequelize to alter tables.
DB_SYNC_ALTER=false

JWT_SECRET=change_this_secret
NODE_ENV=development

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Social login
# Add these redirect URLs in each provider dashboard:
# Google:   http://localhost:5000/api/auth/google/callback
# Facebook: http://localhost:5000/api/auth/facebook/callback
# LinkedIn: http://localhost:5000/api/auth/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
